# Copy file này thành .env.local và điền giá trị từ Supabase → Project Settings → API.
# Để trống cả hai biến để chạy ở CHẾ ĐỘ DEMO (dữ liệu mẫu cục bộ, không cần Supabase).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Bật trang /dev/qr để in mã QR demo (mặc định chỉ bật khi chạy npm run dev).
# VITE_ENABLE_DEV_TOOLS=true

# Email nhận góp ý (mục "Give feedback" trong menu tài khoản). Để trống thì mục này bị vô hiệu hoá.
# VITE_SUPPORT_EMAIL=support@example.com
